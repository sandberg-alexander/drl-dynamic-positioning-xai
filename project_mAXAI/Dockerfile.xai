# Dockerfile.xai (simplified version)
FROM my-ros-base:latest


WORKDIR /app/xai_code

# Copy just requirements first to leverage caching
COPY ./xai_code/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install -r requirements.txt

# Then copy your code
COPY ./xai_code/ .

CMD ["tail", "-f", "/dev/null"]