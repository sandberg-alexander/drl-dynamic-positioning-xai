# Dockerfile.xai (simplified version)
FROM my-ros-base:latest


WORKDIR /app/xai_code

# Copy just requirements first to leverage caching
COPY project_mAXAI/xai_code/requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt

# Then copy your code
COPY project_mAXAI/xai_code/ .

CMD ["tail", "-f", "/dev/null"]