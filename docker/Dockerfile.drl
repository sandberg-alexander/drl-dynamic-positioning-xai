# Dockerfile.drl
FROM my-ros-base:latest

# Install smach BEFORE building packages that depend on it
RUN apt-get update && apt-get install -y ros-noetic-smach inetutils-ping

# Now copy the supervisor package
WORKDIR /root/catkin_ws/src
COPY external/milliampere/workspace/src/supervisor ./supervisor

# Rebuild with the additional package
WORKDIR /root/catkin_ws
RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make"

WORKDIR /app/drl_code

# Copy just requirements first to leverage caching
COPY project_mAXAI/drl_code/requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt

# Then copy your code
COPY project_mAXAI/drl_code/ .

CMD ["tail", "-f", "/dev/null"]