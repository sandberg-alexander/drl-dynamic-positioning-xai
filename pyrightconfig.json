{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.10",
  "include": [
    "milliampere_dp/src",
    "drl/src",
    "xai/src",
    "ros_packages/milliampere_env/src"
  ],
  "exclude": [
    "**/.venv",
    "data/",
    "external/",
    "milliampere_dp/src/milliampere_dp/plotting/"
  ],
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "reportUnusedImport": false
}
